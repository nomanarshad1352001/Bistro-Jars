# Database (platform-provided)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# WhatsApp Business Platform (Cloud API) — server-side only.
# Token for your WhatsApp Business App from Meta for Developers.
WHATSAPP_ACCESS_TOKEN=
# Phone number ID of the WhatsApp Business sender.
WHATSAPP_PHONE_NUMBER_ID=
# Staff number that receives inquiries (E.164 without '+', e.g. 3816XXXXXXXX).
WHATSAPP_NOTIFY_TO=

# Public fallback: number used for wa.me deep links around the site
# (reserve buttons, floating chat button, and the form's "Open WhatsApp" hand-off).
NEXT_PUBLIC_WHATSAPP_NUMBER=381605550199
